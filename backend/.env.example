# ---------- General ----------
APP_ENV=development                 # development | production
# Comma-separated browser origins allowed by CORS (your Vercel URL in production)
ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ---------- Database ----------
# Local: mongodb://localhost:27017 | Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# mock://  = in-memory database (nothing persists; handy for quick local tries)
# No MongoDB installed? Use:  MONGO_URI=mock://
MONGO_URI=mongodb://localhost:27017
MONGO_DB=launchcrew

# ---------- LLM (Groq) ----------
# MOCK_LLM=true runs the whole flow with canned responses; no API keys needed.
MOCK_LLM=true
GROQ_API_KEY=
# Model names change. Check https://console.groq.com/docs/models and fill these in:
GROQ_MODEL=                         # default model (a Llama 70B-class model)
GROQ_FAST_MODEL=                    # cheaper/faster model for Strategist + Designer
GROQ_VISION_MODEL=                  # optional: enables the Critic's visual review
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=5
LLM_REQUEST_TIMEOUT_S=90
LLM_BACKOFF_BASE_S=1
LLM_BACKOFF_MAX_S=30

# ---------- Tools ----------
TAVILY_API_KEY=                     # optional: without it the Researcher uses stub results
NETLIFY_AUTH_TOKEN=                 # optional: without it deploys are simulated

# ---------- Guardrails ----------
MAX_STEPS=30
MAX_TOKEN_BUDGET=150000
AGENT_TIMEOUT_S=240
MAX_CRITIC_ITERATIONS=3
TOOL_ROUNDS_CAP=3
RUNS_PER_HOUR=10
ENGINEER_MAX_TOKENS=6000

# ---------- Storage ----------
STORAGE_BACKEND=mongo               # mongo | local
STORAGE_DIR=./data/artifacts